%%{init: {'theme':'base','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif','themeVariables':{'fontSize':'13px'}}}%%
flowchart LR
  subgraph P1[Phase 1: Data Ingestion]
    A([Start]) --> B[Ingest data\nHot-index updater / map-matching service]
    B --> C{Data completeness\nabove 95%?}
    C -- Yes --> D[Distribute to systems\nUber Michelangelo]
    C -- No --> E[Backfill from last known state\nand flag degraded confidence]
    E --> B
  end

  subgraph P2[Phase 2: Demand Aggregation]
    D --> F[Aggregate demand\ndata Uber Michelangelo]
    F --> G{Demand volume\nabove threshold?}
    G -- Yes --> H[Generate initial forecast\nUber Michelangelo]
    G -- No --> I[Wait for surge conditions]
  end

  subgraph P3[Phase 3: Supply Assessment]
    H --> J[Evaluate supply\nJoyride Fleet Management Dashboard]
    J --> K{Supply availability\nbelow threshold?}
    K -- Yes --> L[Trigger redistribution\nJoyride Fleet Management Dashboard]
    K -- No --> M[Match demand and supply\nUber Michelangelo]
  end

  subgraph P4[Phase 4: Matching Dispatch]
    M --> N[Generate dispatch instructions\nUber DeepETA]
    N --> O{Ride accepted?}
    O -- Yes --> P[Dispatch vehicle\nUber DeepETA]
    O -- No --> Q[Retry dispatch or cancel]
    Q --> M
  end

  subgraph P5[Phase 5: Feedback Retraining]
    P --> R[Evaluate ride completion\nUber Michelangelo]
    R --> S{Ride quality\ngood enough?}
    S -- Yes --> T[Update model parameters\nMichelangelo Online Prediction Service]
    S -- No --> U[Re-evaluate and retrain model]
  end

  subgraph P6[Phase 6: Compliance Monitoring]
    U --> V[Monitor compliance\nRide Report]
    V --> W{Compliance issues raised?}
    W -- Yes --> X[Escalate to higher authority]
    W -- No --> Y[Communicate policy updates\nPopulus Mobility Manager]
    Y --> Z([End])
  end

  style A fill:#0f2a5c,color:#fff,stroke:#0f2a5c
  style Z fill:#0f2a5c,color:#fff,stroke:#0f2a5c
  style Q fill:#0f2a5c,color:#fff,stroke:#0f2a5c
  style U fill:#0f2a5c,color:#fff,stroke:#0f2a5c
  style W fill:#10b3c6,color:#fff,stroke:#10b3c6
  style C fill:#10b3c6,color:#fff,stroke:#10b3c6
  style G fill:#10b3c6,color:#fff,stroke:#10b3c6
  style K fill:#10b3c6,color:#fff,stroke:#10b3c6
  style O fill:#10b3c6,color:#fff,stroke:#10b3c6
  style S fill:#10b3c6,color:#fff,stroke:#10b3c6