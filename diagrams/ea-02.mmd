%%{init: {'theme':'base','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif','themeVariables':{'fontSize':'13px'}}}%%
flowchart TB

  subgraph DEMAND["📈 Demand Signal"]
    direction LR
    UberApp["Uber App\nUser request - Location data"]
    LyftApp["Lyft App\nUser request - Location data"]
    DoorDashApp["DoorDash App\nOrder placement - User location"]
    BoltApp["Bolt App\nRide-hail request - Scooter rental"]
  end

  subgraph SUPPLY["🚚 Supply Positioning"]
    direction TB
    UberMichelangelo["Uber Michelangelo\nML platform - Active projects"]
    LyftAVStrategy["Lyft AV Strategy\nPartnership management - Fleet expansion"]
    WaymoAVDeployment["Waymo LLC\nFreeway operations - City deployments"]
    DoorDashAutonomy["DoorDash Autonomous Delivery Platform\nRobotics orchestration - Drone delivery"]
  end

  subgraph MATCHING["👥 Matching and Assignment"]
    direction TB
    UberDeepETA["Uber DeepETA\nETA residual model - Routing optimization"]
    LyftDispatch["Lyft Dispatch\nAlgorithmic matching - Driver assignment"]
    DoorDashRouting["DoorDash Autonomous Delivery Platform\nOrder routing - Fleet management"]
    BoltMatching["Bolt Technology OÜ\nRide-hail matching - Scooter availability"]
  end

  subgraph ROUTING["🛣️ Routing and Navigation"]
    direction TB
    OpenStreetMap["OpenStreetMap\nBase map data - Geocoding"]
    GoogleMapsPlatform["Google Maps Platform\nRouting - Traffic feeds"]
    UberH3["Uber H3\nHexagonal hierarchical geospatial index"]
    DoorDashDot["DoorDash Dot\nAutonomous robot navigation"]
  end

  subgraph PAYMENTS["💳 Payments and Settlements"]
    direction TB
    StripeConnect["Stripe Connect\nMarketplace payments - Split payouts"]
    Braintree["Braintree\nCard processing - Stored credentials"]
    Twilio["Twilio\nMasked-number voice/SMS"]
  end

  subgraph COMPLIANCE["📜 Compliance and Policy Management"]
    direction TB
    MDS20["Mobility Data Specification 2.0\nProvider API - Agency API - Policy API"]
    GBFS["GBFS General Bikeshare Feed Specification\nPublic real-time vehicle availability feed"]
    RideReport["Ride Report\nCity micromobility permit compliance"]
    Lacuna["Lacuna Technologies\nDigital right-of-way enforcement"]
  end

  subgraph OPERATIONS["🔧 Operations and Fleet Management"]
    direction TB
    Checkr["Checkr Checkr, Inc.\nBackground check API - MVR screening"]
    JoyrideDashboard["Joyride Fleet Management Dashboard\nOperator-side fleet control"]
    BoltInHouseEbike["Bolt in-house e-bike platform\nVertically-integrated vehicle design"]
    WaymoSimulationCity["Simulation City Waymo\nHigher-fidelity successor to Carcraft"]
  end

  UberApp -->|"user request"| SUPPLY
  LyftApp -->|"user request"| SUPPLY
  DoorDashApp -->|"order placement"| SUPPLY
  BoltApp -->|"ride-hail request"| SUPPLY

  SUPPLY -->|"supply data"| MATCHING
  MATCHING -->|"match results"| ROUTING

  ROUTING -->|"route instructions"| PAYMENTS
  PAYMENTS -->|"payment details"| COMPLIANCE

  COMPLIANCE -->|"compliance status"| OPERATIONS
  OPERATIONS -->|"fleet updates"| DEMAND

