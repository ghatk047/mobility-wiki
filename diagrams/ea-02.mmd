  classDef routing fill:#fde68a,stroke:#fbbf24,color:#78350f
  classDef payments fill:#d1fae5,stroke:#05965b,color:#16a34a
  classDef compliance fill:#fee2e2,stroke:#ef4444,color:#dc2626
  classDef operations fill:#f8fafc,stroke:#94a3b8,color:#64748b

  class UberApp,LyftApp,DoorDashApp,BoltApp demand
  class UberMichelangelo,LyftAVStrategy,WaymoAVDeployment,DoorDashAutonomy supply
  class UberDeepETA,LyftDispatch,DoorDashRouting,BoltMatching matching
  class OpenStreetMap,GoogleMapsPlatform,UberH3,DoorDashDot routing
  class StripeConnect,Braintree,Twilio payments
